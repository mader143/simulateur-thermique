import os
import pandas as pd
import matplotlib.pyplot as plt

base_dir = os.path.dirname(os.path.abspath(__file__))
sheet_name = "-40pwm_depuis31"

excel_path = os.path.join(base_dir, "Boucle_ouverte.xlsx")
csv_path = os.path.join(base_dir, f"{sheet_name}.csv")

df_excel = pd.read_excel(excel_path, sheet_name=sheet_name, header=None)
df_excel.columns = ["Temps", "Thermistance 1", "Thermistance 2", "Thermistance 3"]

df_csv = pd.read_csv(csv_path)

# 🔴 Filtre temps ≤ 600 s
df_excel = df_excel[df_excel["Temps"] <= 600]
df_csv = df_csv[df_csv["Temps (s)"] <= 600]

plt.figure()

plt.plot(df_excel["Temps"], df_excel["Thermistance 1"], label="Simulateur - T1")
plt.plot(df_excel["Temps"], df_excel["Thermistance 2"], label="Simulateur - T2")
plt.plot(df_excel["Temps"], df_excel["Thermistance 3"], label="Simulateur - T3")

plt.plot(df_csv["Temps (s)"], df_csv["Thermistance 1 - T1 (°C)"], '--', label="Prototype - T1")
plt.plot(df_csv["Temps (s)"], df_csv["Thermistance 2 - T2 (°C)"], '--', label="Prototype - T2")
plt.plot(df_csv["Temps (s)"], df_csv["Thermistance 3 - T3 (°C)"], '--', label="Prototype - T3")

plt.xlabel("Temps")
plt.ylabel("Température (°C)")
plt.legend()
plt.grid()

plt.show()